# Protected runtime file: copy to .env, chmod 600, then fill every blank value.
# No secret, hostname, image or proxy value is inferred from another installation.
CHORALA_DEPLOYMENT=selfhost
CHORALA_DOMAIN=feedback.satflux.io
CHORALA_PUBLIC_URL=https://feedback.satflux.io
CHORALA_API_URL=https://feedback.satflux.io
CHORALA_WIDGET_CDN_URL=https://feedback.satflux.io/widget.js
CHORALA_ADMIN_HOSTS=
CHORALA_ALLOW_SIGNUP=false
CHORALA_DB_PASSWORD=
CHORALA_AUTH_SECRET=
# Leave bootstrap fields empty. Pass credentials only to an explicit one-off
# seed:admin command, never to the long-running service environment.
CHORALA_BOOTSTRAP_EMAIL=
CHORALA_BOOTSTRAP_PASSWORD=
CHORALA_BOOTSTRAP_NAME=

# Filled by the reviewed offline image bundle, never mutable tags.
CHORALA_API_IMAGE=
CHORALA_DASHBOARD_IMAGE=
CHORALA_WORKER_IMAGE=
CHORALA_POSTGRES_IMAGE=
CHORALA_REDIS_IMAGE=
CHORALA_GATEWAY_IMAGE=

# Obtain these from inspect-target.py. There are deliberately no guessed defaults.
TRAEFIK_CONTAINER=passbolt-traefik-1
TRAEFIK_NETWORK=
TRAEFIK_HTTPS_ENTRYPOINT=
TRAEFIK_CERT_RESOLVER=
# Exact proxy-side IPs only: e.g. one IPv4 /32 or IPv6 /128, separated by spaces.
CHORALA_TRUSTED_PROXY_CIDRS=

# Enable only after real staging delivery/provider verification.
CHORALA_AI_PROVIDER=none
CHORALA_EMAIL_TRANSPORT=none
CHORALA_EMAIL_FROM=feedback@satflux.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Optional provider fields are intentionally absent until configured; an empty URL
# would fail schema validation even while the provider is disabled.
# CHORALA_AI_BASE_URL=https://provider.example.invalid
CHORALA_AI_API_KEY=
# CHORALA_AI_CHAT_MODEL=provider-model
# CHORALA_AI_EMBED_MODEL=provider-embedding-model
CHORALA_RATE_LIMIT_PUBLIC=60
CHORALA_UPLOAD_DIR=/var/lib/chorala/uploads
CHORALA_ATTACHMENT_MAX_BYTES=5000000
CHORALA_ATTACHMENT_QUOTA_BYTES=1000000000
