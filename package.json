{
  "name": "chorala",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "description": "Chorala \u2014 open-core, embeddable, multilingual, AI-native product-feedback platform.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @chorala/db db:generate",
    "db:push": "pnpm --filter @chorala/db db:push",
    "db:migrate": "pnpm --filter @chorala/db db:migrate",
    "db:seed": "pnpm --filter @chorala/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "vitest>tinypool": "2.1.2",
      "hono@^4": "4.13.11",
      "@hono/node-server@^1": "1.19.15",
      "@hono/node-server@^2": "2.0.10",
      "proxy-addr@<2.0.8": "2.0.8",
      "body-parser@^2": "2.4.0",
      "fast-uri@^3": "3.1.9",
      "ip-address@^10": "10.7.4",
      "vite@^7": "7.3.7",
      "nanoid@^3": "3.3.20",
      "source-map-js@^1": "1.2.2",
      "qs@^6": "6.16.0",
      "postcss@^8": "8.5.31",
      "js-yaml@^4": "4.3.2",
      "brace-expansion@^2": "2.1.7",
      "esbuild@^0.27.0": "0.28.1"
    }
  }
}
