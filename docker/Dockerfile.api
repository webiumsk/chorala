# syntax=docker/dockerfile:1
# Chorala API (Hono). Internal packages export TS source, so the API runs via tsx.
FROM node:24-slim AS base
RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @chorala/widget build && test -s packages/widget/dist/widget.js

ENV NODE_ENV=production
EXPOSE 8787
# Compose runs migrations once before this service becomes eligible to start.
CMD ["pnpm", "--filter", "@chorala/api", "start"]
