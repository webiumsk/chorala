# =============================================================================
# Chorala — environment template. Copy to .env and fill required values.
#   cp .env.example .env
# packages/config zod-validates these at boot and fails fast if a REQUIRED var
# (DATABASE_URL, CHORALA_AUTH_SECRET) is missing or malformed.
# =============================================================================

# --- Deployment -------------------------------------------------------------
CHORALA_DEPLOYMENT=selfhost              # selfhost | cloud
# Docker Compose uses Caddy at :80. Set all public URLs to your HTTPS host in production.
# For pnpm dev instead use dashboard :3015 and API/widget :8787.
CHORALA_DOMAIN=:80                     # feedback.example.com enables automatic TLS
CHORALA_PUBLIC_URL=http://localhost    # base URL of the dashboard/portal
CHORALA_ADMIN_HOSTS=                   # optional extra admin hostnames, comma-separated
CHORALA_API_URL=http://localhost    # base URL of the API
CHORALA_API_PORT=8787                  # internal API port, independent of public URL
NODE_ENV=development                  # development | production | test

# --- Database (REQUIRED) ----------------------------------------------------
# Compose requires a URL-safe random password; e.g. openssl rand -hex 32.
CHORALA_DB_PASSWORD=
# Used by local development. Compose injects its internal database URL automatically.
DATABASE_URL=postgres://chorala:replace_with_your_password@localhost:5432/chorala

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) -----------------------------------------------------
CHORALA_AUTH_SECRET=                     # REQUIRED: 32+ byte random string
CHORALA_ALLOW_SIGNUP=false               # self-host public admin signup is disabled by default
# First-admin bootstrap only; do not seed demo accounts in production.
CHORALA_BOOTSTRAP_EMAIL=
CHORALA_BOOTSTRAP_PASSWORD=               # explicit password, 16-128 characters; never logged
CHORALA_BOOTSTRAP_NAME=                   # optional display name
# Optional OAuth providers for admin login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (optional; features degrade cleanly if absent) ----------------------
CHORALA_AI_PROVIDER=ollama               # ollama | openai | anthropic | none
CHORALA_AI_BASE_URL=http://localhost:11434
CHORALA_AI_API_KEY=                      # required for openai/anthropic providers
CHORALA_AI_CHAT_MODEL=llama3.1:8b
CHORALA_AI_EMBED_MODEL=nomic-embed-text
CHORALA_AI_DEDUP_THRESHOLD=0.86          # cosine similarity (0-1) to suggest a merge

# --- Email (optional; app logs a warning and runs if absent) ----------------
CHORALA_EMAIL_TRANSPORT=smtp             # smtp | resend | none
CHORALA_EMAIL_FROM=feedback@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- Billing (cloud deployment only; inert in selfhost) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Widget / public API ----------------------------------------------------
CHORALA_WIDGET_CDN_URL=http://localhost/widget.js
CHORALA_RATE_LIMIT_PUBLIC=60             # requests/min per IP per project on public API

# Bug-report screenshots: absolute path shared by API + dashboard (must be reachable by both)
CHORALA_UPLOAD_DIR=/var/lib/chorala/uploads
CHORALA_ATTACHMENT_MAX_BYTES=5000000
CHORALA_ATTACHMENT_QUOTA_BYTES=1000000000
